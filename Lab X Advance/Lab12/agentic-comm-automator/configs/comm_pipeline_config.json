{
  "context": {
    "company_name": "Demo Co.",
    "student_name": "${STUDENT_NAME}",
    "student_id": "${STUDENT_ID}"
  },
  "error_alert": {
    "to": ["${SENDER_EMAIL}"]
  },
  "tasks": [
    {
      "name": "Send Daily Sales Report Email",
      "type": "send_email",
      "parameters": {
        "recipients": {
          "to": ["${TEST_RECIPIENT_EMAIL}"],
          "cc": ["${SENDER_EMAIL}"]
        },
        "subject_template": "Daily Sales Report - {report_date}",
        "body_template": "Dear Team,\n\nPlease find the latest sales report for {report_date} attached. Total sales: ${sales_figure:.2f}. Total active customers: {total_customers}.\n\nBest regards,\nAutomated Agent ({company_name})\n\nStudent: {student_name}\nStudent ID: {student_id}",
        "attachments": ["{attachment_path_1}", "{attachment_path_2}"],
        "is_html": false
      }
    },
    {
      "name": "Send Sales Alert SMS",
      "type": "send_sms",
      "parameters": {
        "phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
        "message_template": "Sales for {report_date} are ${sales_figure:.2f}. Customers: {total_customers}.",
        "carrier_name": "${TEST_SMS_CARRIER}"
      }
    },
    {
      "name": "Simulate Incoming Request Email (to self)",
      "type": "send_email",
      "parameters": {
        "recipients": {
          "to": ["${SENDER_EMAIL}"]
        },
        "subject_template": "Data Request for {report_date} - Urgent",
        "body_template": "Hello Agent,\n\nWe need the latest data for {report_date}. This is an urgent request for new data processing. Attachment included.\n\nThank you,\nClient Team\n\nStudent: {student_name}\nStudent ID: {student_id}",
        "attachments": ["{attachment_path_1}"],
        "is_html": false
      },
      "output_context_key": "simulated_email_sent"
    },
    {
      "name": "Process Incoming Data Requests",
      "type": "process_inbox",
      "parameters": {
        "mailbox": "INBOX",
        "wait_before_seconds": 10,
        "retries": 3,
        "retry_delay_seconds": 5,
        "search_criteria": {
          "status": "UNSEEN",
          "from_sender": "${SENDER_EMAIL}",
          "subject_contains": "Data Request",
          "ignore_subject_prefixes": ["Re:"]
        },
        "download_attachments_base_dir": "data/incoming_attachments",
        "rules": [
          {
            "name": "Download attachments of requests from self",
            "if": {
              "from_sender_is": "${SENDER_EMAIL}",
              "subject_contains": "Request"
            },
            "then": {
              "download_attachments": true,
              "mark_as_read": true
            }
          },
          {
            "name": "SMS alert for urgent emails",
            "if": {
              "body_contains": "urgent"
            },
            "then": {
              "send_sms_alert": true,
              "alert_phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
              "alert_carrier": "${TEST_SMS_CARRIER}",
              "alert_message_template": "URGENT request: {subject}. Files saved to {saved_to}"
            }
          },
          {
            "name": "Auto-reply",
            "if": {
              "body_contains": "new data processing"
            },
            "then": {
              "reply_with_template": "Agent received your request '{subject}'. Saved files: {saved_files}. We are now processing the new data.\n\nStudent: {student_name}\nStudent ID: {student_id}",
              "reply_subject_template": "Re: {subject} - Received & Processing"
            }
          }
        ]
      },
      "output_context_key": "processed_inbox_results"
    }
  ]
}
