# Copy this file to ".env" and fill in your real values. NEVER commit ".env".
# (You can reuse the same Gmail + App Password as the BASIC lab.)
SENDER_EMAIL=your_gmail_address@gmail.com
SENDER_APP_PASSWORD=your_generated_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Student info (printed in every email body for the assignment screenshot)
STUDENT_NAME=Firstname Lastname
STUDENT_ID=6XXXXXXXXXX

# Recipient for test emails and SMS
TEST_RECIPIENT_EMAIL=another_email@example.com
TEST_SMS_PHONE_NUMBER=1234567890
TEST_SMS_CARRIER=att
