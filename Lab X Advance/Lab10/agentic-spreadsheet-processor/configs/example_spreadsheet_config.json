{
    "input_file": "data/input_data.xlsx",
    "output_file": "data/output_report.xlsx",
    "tasks": [
        {
            "type": "copy_data",
            "source_sheet": "SalesData",
            "dest_sheet": "Raw Data"
        },
        {
            "type": "calculate_column",
            "sheet": "Raw Data",
            "target_column": "D",
            "header": "Total Revenue",
            "start_row": 2,
            "formula": "=B{row}*C{row}",
            "number_format": "#,##0.00"
        },
        {
            "type": "calculate_column",
            "sheet": "Raw Data",
            "target_column": "E",
            "header": "Status",
            "start_row": 2,
            "formula": "=IF(D{row}>1000,\"High Value\",\"Standard\")"
        },
        {
            "type": "conditional_format",
            "sheet": "Raw Data",
            "range": "D2:D100",
            "rule_type": "color_scale",
            "min_color": "F8696B",
            "mid_color": "FFEB84",
            "max_color": "63BE7B"
        },
        {
            "type": "conditional_format",
            "sheet": "Raw Data",
            "range": "E2:E100",
            "rule_type": "expression",
            "formula": "=$E2=\"High Value\"",
            "fill_color": "92D050",
            "font_color": "000000"
        },
        {
            "type": "data_validation",
            "sheet": "Raw Data",
            "range": "B2:B100",
            "validation_type": "whole",
            "operator": "greaterThanOrEqual",
            "formula1": "0",
            "error_title": "Invalid Quantity",
            "error_message": "Quantity must be a whole number >= 0."
        },
        {
            "type": "summary",
            "sheet": "Summary",
            "source_sheet": "Raw Data",
            "label_column": "A",
            "value_column": "D",
            "quantity_column": "B",
            "start_row": 2
        },
        {
            "type": "chart",
            "sheet": "Raw Data",
            "chart_type": "bar",
            "data_range": "D1:D10",
            "category_range": "A2:A10",
            "title": "Revenue by Product",
            "x_axis_title": "Product",
            "y_axis_title": "Revenue",
            "top_left_cell": "G2"
        }
    ]
}
